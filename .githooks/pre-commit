#!/bin/bash
set -o pipefail   # ★2026-11-19 全体レビュー中5：パイプの途中（python）が失敗した時に空の index.html をステージに載せない
# ★2026-11-17 全体レビュー中7：版の印 APP_BUILD を「記録する中身（ステージ）」だけに書く。
#   前は作業中の index.html を書き換えて丸ごと git add していた＝ステージに乗せていない途中の直しまで公開された。
#   印は秒まで（同じ分に2回公開しても印が変わる＝appBuildGate が効く）。フックはリポジトリの .githooks（core.hooksPath）＝どの複製でも同じ。
if git diff --cached --name-only | grep -qx 'index.html'; then
  NEW=$(TZ=Asia/Tokyo date +%Y%m%d-%H%M%S)
  SETB='import sys,re
new=sys.argv[1]; s=sys.stdin.read()
m=re.search(r"const APP_BUILD = '"'"'(\d{8}-\d{4,6})'"'"';",s)
if not m: sys.exit("APP_BUILD が見つからない＝記録を止めます")
sys.stdout.write(s.replace(m.group(0),"const APP_BUILD = '"'"'%s'"'"';"%new,1))'
  BLOB=$(git show :index.html | python3 -c "$SETB" "$NEW" | git hash-object -w --stdin) || exit 1
  [ -n "$BLOB" ] || exit 1
  SZ=$(git cat-file -s "$BLOB" 2>/dev/null || echo 0); [ "$SZ" -gt 1000000 ] || { echo "版の印を入れた index.html が小さすぎる（${SZ}B）＝記録を止めます"; exit 1; }
  git update-index --cacheinfo "100644,$BLOB,index.html" || exit 1
  # 作業中のファイルは印の行だけ同じ値にそろえる（ほかの変更はステージに乗せない）
  if python3 -c "$SETB" "$NEW" < index.html > index.html.tmp_build && [ "$(wc -c < index.html.tmp_build)" -gt 1000000 ]; then mv index.html.tmp_build index.html; else rm -f index.html.tmp_build; fi   # 失敗や空の時は作業中のファイルに触らない
fi
# ★2026-11-17 文法の確かめ（new Function）：記録する中身（ステージ）の index.html と .gs を見る。NG なら記録しない
T="$(git rev-parse --show-toplevel)"; SD=$(mktemp -d)
for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '^(index\.html|[^/]+\.gs)$'); do mkdir -p "$SD/$(dirname "$f")"; git show ":$f" > "$SD/$f"; done
if ls "$SD"/* >/dev/null 2>&1; then
  ( cd "$SD" && bash "$T/chk_syntax.sh" $(cd "$SD" && ls) ) || { echo "記録を止めました（文法の誤り＝このままだとポータル全体が止まる）"; rm -rf "$SD"; exit 1; }
fi
rm -rf "$SD"
exit 0
