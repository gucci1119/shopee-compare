#!/bin/bash
# 公開の直前に、大物の書き込み（chk_bigwrite.sh）と鍵・合言葉の直書き（chk_secret.sh）が増えていないかを見る
T="$(git rev-parse --show-toplevel)"
if [ "$ALLOW_BIGWRITE" != "1" ]; then bash "$T/chk_bigwrite.sh" || { echo "push を止めました（大物の書き込み）"; exit 1; }; fi
if [ "$ALLOW_SECRET" != "1" ]; then bash "$T/chk_secret.sh" || { echo "push を止めました（鍵・合言葉）"; exit 1; }; fi
# ★2026-11-17 文法の確かめ（new Function）：送る先頭の版の index.html と .gs を見る（b87eecf の事故の再発よけ・外す鍵は無し）
SD=$(mktemp -d)
while read lref lsha rref rsha; do
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue
  for f in $(git ls-tree --name-only "$lsha" | grep -E '^(index\.html|[^/]+\.gs)$'); do git show "$lsha:$f" > "$SD/$f"; done
  ( cd "$SD" && bash "$T/chk_syntax.sh" $(ls) ) || { echo "push を止めました（文法の誤り＝このままだとポータル全体が止まる）"; rm -rf "$SD"; exit 1; }
done
rm -rf "$SD"
exit 0
