#!/bin/bash
# 公開の直前に、大物の書き込み（chk_bigwrite.sh）と鍵・合言葉の直書き（chk_secret.sh）が増えていないかを見る
T="$(git rev-parse --show-toplevel)"
if [ "$ALLOW_BIGWRITE" != "1" ]; then bash "$T/chk_bigwrite.sh" || { echo "push を止めました（大物の書き込み）"; exit 1; }; fi
if [ "$ALLOW_SECRET" != "1" ]; then bash "$T/chk_secret.sh" || { echo "push を止めました（鍵・合言葉）"; exit 1; }; fi
exit 0
