function norm_(x) {
  return String(x == null ? '' : x)
    .replace(/[\u2010\u2011\u2012\u2013\u2014\u2015\u2043\u2212\u30fc\u007e\uff5e\u301c\u005f\ufe58\uff0d\uff70]/g, '-')
    .replace(/[\uff21-\uff3a\uff41-\uff5a\uff10-\uff19]/g, function (c) { return String.fromCharCode(c.charCodeAt(0) - 0xFEE0); })
    .replace(/\s+/g, '').trim().toUpperCase();
}
function plan_() {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var sh = SHEET_NAME ? ss.getSheetByName(SHEET_NAME) : ss.getSheets()[0];
  var last = sh.getLastRow(), width = sh.getLastColumn();
  var head = sh.getRange(1, 1, 1, width).getDisplayValues()[0];
  var cI = head.indexOf('ItemID'), cS = head.indexOf('Status'), cD = head.indexOf('PurchaseDate');
  if (cI < 0 || cS < 0) throw new Error('ItemID / Status の列が見つかりません');
  var vals = sh.getRange(2, 1, last - 1, width).getDisplayValues();
  var found = {}; FOUND_IDS.forEach(function (x) { found[norm_(x)] = 1; });
  var out = [], cnt = {};
  for (var i = 0; i < vals.length; i++) {
    var id = norm_(vals[i][cI]); if (!id) { out.push(null); continue; }
    var cur = String(vals[i][cS] || '');
    var d = cD >= 0 ? new Date(String(vals[i][cD]).replace(/-/g, '/')) : null;
    var fresh = d && !isNaN(d.getTime()) && d >= KEEP_WAITING_FROM;
    var nv;
    if (found[id]) nv = '在庫保管中';
    else if (cur === '入庫待ち' && fresh) nv = '入庫待ち';
    else nv = '販売済み';
    out.push(nv);
    if (nv !== cur) { var k = (cur || '(空)') + ' → ' + nv; cnt[k] = (cnt[k] || 0) + 1; }
  }
  return { sh: sh, cS: cS, out: out, cnt: cnt, vals: vals };
}
function dryRun() {
  var p = plan_(), t = 0, msg = [];
  Object.keys(p.cnt).forEach(function (k) { msg.push('  ' + k + ' : ' + p.cnt[k] + '行'); t += p.cnt[k]; });
  Logger.log('【変更されるのはこれだけ・まだ書き換えていません】\n' + msg.join('\n') + '\n  合計 ' + t + '行 / 変更なし ' + (p.out.length - t) + '行');
}
function apply() {
  var p = plan_(), t = 0;
  var col = [];
  for (var i = 0; i < p.out.length; i++) col.push([p.out[i] == null ? p.vals[i][p.cS] : p.out[i]]);
  p.sh.getRange(2, p.cS + 1, col.length, 1).setValues(col);
  Object.keys(p.cnt).forEach(function (k) { t += p.cnt[k]; });
  Logger.log('✅ 反映しました：' + t + '行を変更');
}
